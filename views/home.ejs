<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <%- include('partials/includes.ejs') %>
</head>

<body>
    <header>
        <%- include('partials/navbar.ejs') %>
    </header>

    <div class="main">

        <div class="filters">
            <h1>[username] Favorites:</h1>

            <label for="nameFilter">Search by Name:</label>
            <input type="text" id="nameFilter">
            <br />

            <label for="foodCategories">Sort By:</label>
            <select name="foodCategories" id="foodCategories">
                <option>Categories will go here</option>
            </select>
        </div>

        <div class="logoutBox">
            <button id="logoutBtn">Log Out</button>
        </div>

        <h2 class="foodName">Food name goes here</h2>

        <div class="recipeInfoBox">
            <div class="imageAndInfo">
                <div id="imagePlaceholder">Image will go here</div>
                <p>Category:</p>
                <p>Your Rating:</p>
                <p>Source:</p>
            </div>

            <div class="recipeIngredients">
                <h2>Ingredients:</h2>
                <ul>
                    <li>Ingredient 1</li>
                    <li>Ingredient 2</li>
                    <li>Ingredient 3</li>
                </ul>
            </div>

            <div class="recipeInstructions">
                <h2>Instructions:</h2>
                <p>Instructions go here</p>
            </div>
        </div>


    </div>
</body>

</html>