<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <%- include('partials/includes.ejs') %>
</head>

<body>
    <div class="main">

        <header>
            <%- include('partials/navbar.ejs') %>
        </header>

        <!-- loop through the recipes and print them out -->
        <h1>Recipe List</h1>
        <% for (let recipe of recipes) { %>
            <p>
                <%= recipe[`Recipe Name`] %>
            </p>
            <% } %>

    </div>
</body>

</html>